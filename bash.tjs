import { execSync } from 'child_process';

function handle({
	args
} = {}) {
	if (args.length === 1) {
		console.log(`Usage: ${args[0]} <bash command>`);
		return;
	}
	try {
		const stdout = execSync(args.slice(1).join(' '), {
			stdio: 'inherit',
			encoding: 'utf-8',
		});
	} catch (err) {
		const exitCode = err.status;
		return exitCode;
	}
	return 0;
}

export default handle;
