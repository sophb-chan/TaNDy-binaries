import * as fs from 'node:fs';
import * as path from 'node:path';

const MAGIC_SIGNATURES = [
  { signature: Buffer.from([0x89, 0x50, 0x4E, 0x47]), type: 'PNG image' },
  { signature: Buffer.from([0xFF, 0xD8, 0xFF]), type: 'JPEG image' },
  { signature: Buffer.from([0x47, 0x49, 0x46, 0x38]), type: 'GIF image' },
  { signature: Buffer.from([0x52, 0x49, 0x46, 0x46]), type: 'RIFF container' },
  { signature: Buffer.from([0x1F, 0x8B]), type: 'gzip compressed' },
  { signature: Buffer.from([0x7F, 0x45, 0x4C, 0x46]), type: 'ELF executable' },
  { signature: Buffer.from([0x50, 0x4B, 0x03, 0x04]), type: 'ZIP archive' },
  { signature: Buffer.from([0x25, 0x50, 0x44, 0x46]), type: 'PDF document' },
  { signature: Buffer.from([0x42, 0x5A, 0x68]), type: 'bzip2 compressed' },
];

const TEXT_PATTERNS = [
  { pattern: /^#!.*\n/, type: 'Shell script' },
  { pattern: /^<\?php/, type: 'PHP source' },
  { pattern: /^<!DOCTYPE html/i, type: 'HTML document' },
  { pattern: /^(?:function\s+\w+|const\s+\w+|var\s+\w+|import\s+)/, type: 'JavaScript source' },
  { pattern: /^\s*(?:public\s+(class|interface)|using\s)/, type: 'C# source' },
];

function detectFileType(filePath, followSymlinks = true) {
  try {
    const stat = followSymlinks ? fs.statSync(filePath) : fs.lstatSync(filePath);
    
    if (stat.isSymbolicLink()) {
      const target = fs.readlinkSync(filePath);
      return { type: `symbolic link → ${target}`, size: 0 };
    }
    
    if (stat.isDirectory()) {
      return { type: 'directory', size: stat.size };
    }
    
    if (stat.size === 0) {
      return { type: 'empty file', size: 0 };
    }
    
    const buffer = fs.readFileSync(filePath);
    
    for (const sig of MAGIC_SIGNATURES) {
      if (buffer.slice(0, sig.signature.length).equals(sig.signature)) {
        return { type: sig.type, size: stat.size };
      }
    }
    
    try {
      const text = buffer.toString('utf8').slice(0, 256);
      
      for (const { pattern, type } of TEXT_PATTERNS) {
        if (pattern.test(text)) {
          return { type, size: stat.size };
        }
      }
      
      if (/^[\x20-\x7E\n\r\t]+$/.test(text)) {
        return { type: 'ASCII text', size: stat.size };
      }
      
      try {
        const decoded = buffer.slice(0, 512).toString('utf8');
        if (/[\u0080-\uD7FF\uE000-\uFFFF]/.test(decoded)) {
          return { type: 'UTF-8 Unicode text', size: stat.size };
        }
      } catch {}
      
      return { type: 'data', size: stat.size };
    } catch {
      return { type: 'binary data', size: stat.size };
    }
  } catch (err) {
    throw err;
  }
}

function printUsage() {
  console.log(`Usage: file [options] <filename> [filename...]

Options:
  --version    Show version information
  --help       Show this help message
  -L           Follow symlinks (default)
  -P           Don't follow symlinks

Description:
  Determine file type by examining file contents.`);
}

async function handle({
  args,
  binaries,
  flags,
} = {}) {
  const followSymlinks = !(flags?.modifiers?.includes('P'));
  
  if (flags?.modifiers?.includes('help') || flags?.modifiers?.includes('h')) {
    printUsage();
    return;
  }
  
  if (flags?.modifiers?.includes('version') || flags?.modifiers?.includes('v')) {
    console.log('file 1.0.0 - TaNDy Binary');
    return;
  }
  
  const filenames = args.slice(1);
  
  if (filenames.length === 0) {
    console.error('file: No arguments given');
    console.error('Try \'file --help\' for more information.');
    return;
  }
  
  for (const filePath of filenames) {
    try {
      const resolvedPath = path.resolve(filePath);
      const fileInfo = detectFileType(resolvedPath, followSymlinks);
      
      console.log(`${resolvedPath}: ${fileInfo.type} (${fileInfo.size} bytes)`);
    } catch (err) {
      if (err.code === 'ENOENT') {
        console.error(`file: '${filePath}': No such file or directory`);
      } else {
        console.error(`file: '${filePath}': ${err.message}`);
      }
    }
  }
}

export default handle;
