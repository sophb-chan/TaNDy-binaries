import * as fs from 'node:fs';
import * as path from 'node:path';

function handle({
	args,
	flags
} = {}) {
	if (flags.modifiers.h || flags.modifiers.help) {
		console.log("Usage: list [target directory]\n");
		console.log("=== Flags ===");
		console.log("--help    (-h) - Shows this");
		console.log("--file    (-F) - Only list files");
		console.log("--dir     (-D) - Only list directories");
		console.log("--symlink (-S) - Only list symbolic links");
		console.log("--dont-skip-hidden (-d) - List files and directories that start with a period");
		return;
	}

	const onlyDirs = flags.modifiers.dir || flags.modifiers.D,
		onlyFiles = flags.modifiers.file || flags.modifiers.F,
		onlySymlinks = flags.modifiers.symlink || flags.modifiers.S,
		dontIgnoreHidden = flags.modifiers['dont-skip-hidden'] || flags.modifiers.d;

	const dir = args[1] ?? '.', list = fs.readdirSync(dir, { withFileTypes: true });
	if (list.length === 0)
		console.log('\x1B[2;3m(empty)\x1B[0m');

	const ESC = '\x1b', width = Infinity; // 16;

	let outputText = '', lastLineLength = 0;
	for (const [index, entry] of list.filter(
		// Filter out
		v => dontIgnoreHidden ? true : !v.name.startsWith('.')
	).entries()) {
		let listString;
		if (entry.isFile()) {
			// File handler

			// Skip if the command is only allowed to display directories or symbolic link
			if (onlyDirs || onlySymlinks) continue;

			const fullPath = path.join(dir, entry.name);
			try {
				// Check if the file is executable
				fs.accessSync(fullPath, fs.constants.X_OK);
				// Color the text green if the file is executable
				listString = `${ESC}[32m${entry.name}${ESC}[0m`;
			} catch {
				// Display normally if the file is not executable
				listString = entry.name;
			}
		} else if (entry.isDirectory()) {
			// Directory handler

			// Skip if the command is only allowed to display files or symbolic links
			if (onlyFiles || onlySymlinks) continue;

			// Style: bright yellow
			listString = `${ESC}[93m${entry.name}${ESC}[0m`;
		} else if (entry.isSymbolicLink()) {
			// Symlink handler

			// Skip if the command is only allowed to display directories or files
			if (onlyDirs || onlyFiles) continue;

			// Style: bold, cyan
			listString = `${ESC}[1;36m${entry.name}${ESC}[0m`;
		} else {
			// Unknown file type handler

			// Style: bold, red
			listString = `${ESC}[1;31m?? ${entry.name}${ESC}[0m`;
		}

		// Append file string to final output
		outputText += listString;
		// console.log(lastLineLength, '+', entry.name.length + 2, '=', lastLineLength + entry.name.length + 2, '- allowed total:', process.stdout.columns);
		lastLineLength += listString.length;
		if (
			width === Infinity
			? lastLineLength + entry.name.length + 2 > process.stdout.columns // Break line if it exceeds the terminal width
			: (index !== 0 && (index + 1) % width === 0) || width === 1 // Break line if it exceeds max item count per line
		) {
			// Separate by newline if it exceeds the total allowed width otherwise
			outputText += '\n';
			lastLineLength = 0;
			// console.log('Break!');
		}
		// Separate by two spaces (for consistency with Linux's "ls") if it's still within the total allowed width
		else if (index !== list.length - 1) {
			outputText += '  ';
			lastLineLength += 2;
		}
	}

	// Output the directory listing
	console.log("\n\x1b[1;97mFiles:\x1b[0m\n");
	console.log(outputText);
}

export default handle;
