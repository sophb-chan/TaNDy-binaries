import * as fs from 'fs';
import * as path from 'path';

async function fetchFromRemote(filePath) {
	const remoteSrc = 'https://raw.githubusercontent.com/sophb-chan/TaNDy/main/';
	const remoteURL = new URL(remoteSrc);
	remoteURL.pathname = path.join(remoteURL.pathname, filePath);
	const r = await fetch(remoteURL.toString());
	if (r.status !== 200) throw new Error(`Got HTTP status code ${r.status} while fetching ${filePath} from remote.`);
	return await r.text();
}
function compareSemver(semverA, semverB) {
	// 0 → Semvers are equal
	// -1 → Semver B is greater than Semver A
	// 1 → Semver A is greater than Semver B
	// Anything else → You fucked up

	const eraseRegex = /^v|-[0-9a-z-]+$/i;
	const partsA = semverA.replace(eraseRegex, '').split('.').map(v => parseInt(v)),
		partsB = semverB.replace(eraseRegex, '').split('.').map(v => parseInt(v));

	for (let i = 0; i < 3; i++) {
		const numA = partsA[i] || 0, numB = partsB[i] || 0;
		if (numA > numB) return 1;
		if (numA < numB) return -1;
	}
	return 0;
}
async function handle({
	tandyDir,
	tandyVer,
	rlInterface,
	flags,
} = {}) {
	const fileInfo = {
		'term.js': {
			remoteName: 'term.js',
			needsRestart: true,
		},
		'minimist-string.js': {
			remoteName: 'minimist-string.js',
			needsRestart: true,
		},
		'tandy': {
			remoteName: 'tandy.js',
			needsRestart: true,
		},
		'taskmgr.js': {
			remoteName: 'taskmgr.js',
			needsRestart: true,
		},
		'package.json': {
			remoteName: 'package.json',
		},
	};
	const breakingChanges = await fetchFromRemote('docs/BREAKING_CHANGES.md');
	const packageText = await fetchFromRemote('package.json'),
		packageObject = JSON.parse(packageText),
		remoteVersion = packageObject.version;

	const remoteSemverComparison = compareSemver(remoteVersion, tandyVer);
	if (remoteSemverComparison !== 1) {
		console.log('Your installation of TaNDy is up to date.');
		if (remoteSemverComparison === -1)
			console.log("\x1B[2;3;96m(You're an early bird!)\x1B[0m");
		return;
	}

	const includesBreakingChanges = (() => {
		const lineRegex = /^##\s*(v?\d+\.\d+\.\d+(?:-[0-9a-z-]+)?) -> (v?\d+\.\d+\.\d+(?:-[0-9a-z-]+)?)\s*$/i;
		const lines = breakingChanges.split(/\r?\n|\r/), breakLines = lines.filter(l => lineRegex.test(l));

		const changeChain = [tandyVer];
		for (const breakLine of breakLines) {
			const [oldVer, newVer] = [...lineRegex.exec(breakLine)].slice(1);
			if (compareSemver(oldVer, changeChain.at(-1)) === 0)
				changeChain.push(newVer);
			if (compareSemver(newVer, remoteVersion) === 0) break;
		}
		return changeChain.length > 1;
	})();

	console.log(`Your installation of TaNDy is out of date! (Local: ${tandyVer} / Remote: ${remoteVersion})`);
	if (includesBreakingChanges)
		console.warn(`Updating TaNDy may cause some binaries to break, and not all binaries are guaranteed to have an updated version.`);
	if (!flags.modifiers.y) {
		while (true) {
			const proceed = (
				await rlInterface.question('Do you want to proceed with an update? [y/N] ')
			).toLowerCase() || 'n';
			const isValidAnswer = /^(?:y(?:es)?|no?)?$/i.test(proceed);

			if (isValidAnswer) {
				const wantsToProceed = /^y(?:es)?$/i.test(proceed);

				if (wantsToProceed) break;
				else throw 'Update aborted.';
			} else console.error('Invalid answer.');
		}
	}

	let restartNeeded = false;
	const changed = [];
	for (const [localName, info] of Object.entries(fileInfo)) {
		const { remoteName, needsRestart } = info;
		console.log(`Checking '${localName}'...`);
		const localPath = path.join(tandyDir, localName);
		const remoteContent = await fetchFromRemote(remoteName);
		const localContent = fs.readFileSync(localPath, { encoding: 'utf-8' });
		if (remoteContent === localContent) {
			console.log(`No need to update '${localName}', no changes have been made.`);
			continue;
		}
		restartNeeded ||= needsRestart ?? false;
		changed.push(localName);
		console.log(`Updating '${localName}'...`);
		fs.writeFileSync(localPath, remoteContent);
		console.log(`Updated '${localName}'.`);
	}
	if (changed.length > 0) {
		console.log(`TaNDy has been updated to v${remoteVersion}!`);
		if (restartNeeded)
			console.log('Please restart TaNDy to apply all changes.');
	}
}

export default handle;
