import * as fs from 'fs';
import * as path from 'path';

async function fetchFromRemote(filepath) {
	const remoteSrc = 'https://raw.githubusercontent.com/sophb-chan/TaNDy/main/';
	const r = await fetch(remoteSrc + filepath);
	if (r.status !== 200) throw r.status;
	return await r.text();
}
async function handle({
	tandyDir,
	flagsObj,
	rlInterface,
} = {}) {
	// Conversion table between local and remote filenames
	const nametable = {
		'term.js': 'term.js',
		'minimist-string.js': 'minimist-string.js',
		'tandy': 'tandy.js',
	};

	// Contents of remotely-stored files
	const remoteContents = {};
	// List files that need to be updated
	const needsUpdate = {};
	for (const [localName, remoteName] of Object.entries(nametable)) {
		console.log(`Checking '${localName}'...`);
		const localContent = fs.readFileSync(path.join(tandyDir, localName), { encoding: 'utf-8' });
		try {
			const remoteContent = await fetchFromRemote(remoteName);
			remoteContents[remoteName] = remoteContent;
			const upToDate = localContent === remoteContent;
			needsUpdate[localName] = !upToDate;
		} catch (err) {
			if (err?.message)
				console.error(`Error when checking '${localName}' - ${err.name}: ${err.message}`);
			else if (Number.isInteger(err))
				console.error(`Error when checking '${localName}' - Got HTTP status code ${err}.`);
			else
				console.error(`Error when checking '${localName}' - RawThrow: ${JSON.stringify(err)}`);
			console.warn('Assuming up-to-date; continuing without fetch.');
			needsUpdate[localName] = false;
		}
	}

	// Update files that need to be updated
	if (!Object.values(needsUpdate).some(Boolean)) {
		console.log('Your installation of TaNDy is already up-to-date.');
		return;
	}
	if (!(flagsObj.y || flagsObj['assume-yes'])) {
		let updateStr = '';
		const outdated = Object.entries(needsUpdate).filter(v => v[1]).map(v => v[0]);
		for (const [index, pkg] of outdated.entries()) {
			updateStr += pkg;
			if (index === outdated.length - 1) updateStr += '';
			else if (index === outdated.length - 2) updateStr += ' and ';
			else updateStr += ', ';
		}
		const ask = async () => {
			const answer = (await rlInterface.question(`${updateStr} need${outdated.length === 1 ? 's' : ''} to update. Proceed? [Y/n] `)).toLowerCase() || 'y';
			if (!'yn'.includes(answer)) {
				console.log('Invalid response.');
				return await ask();
			}
			return answer;
		};
		const proceed = await ask() === 'y';
		if (!proceed) return;
	}
	for (const [localName, isOutdated] of Object.entries(needsUpdate)) {
		if (!isOutdated) continue;
		console.log(`Updating '${localName}'...`);
		const newContent = remoteContents[nametable[localName]];
		fs.writeFileSync(path.join(tandyDir, localName), newContent);
	}
	console.log("Updated successfully!");
}

export default handle;
