function handle({
	binaries
} = {}) {
	let listString = '';
	const width = 8;

	for (const [index, binary] of binaries.entries()) {
	    listString += binary;
	    if ((index !== 0 && (index + 1) % width === 0) || width === 1) listString += '\n';
	    else if (index !== binaries.length - 1) listString += ', ';
	}

	console.log("\n\x1b[1;97mCommands:\x1b[0m\n");
	console.log(listString);
}
export default handle;
